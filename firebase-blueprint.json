{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered KeyAi user profile, role assignment, and credit balance state.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "username": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["user", "moderator", "admin", "super_admin"]
        },
        "credits": {
          "type": "number"
        },
        "unlimitedCredits": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended"]
        },
        "lastCreditReset": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "username",
        "role",
        "credits",
        "unlimitedCredits",
        "status",
        "lastCreditReset",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized admin role and permission record stored securely in Firestore.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "username": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "admin", "moderator"]
        },
        "permissions": {
          "type": "array",
          "description": "Up to 10 capability strings granted to this admin."
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "username", "role", "permissions", "grantedBy", "createdAt"]
    },
    "CreditTransaction": {
      "title": "CreditTransaction",
      "description": "Immutable ledger entry for every credit balance mutation.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "signup_bonus",
            "daily_reset",
            "ai_usage",
            "admin_add",
            "admin_deduct",
            "admin_set",
            "admin_unlimited"
          ]
        },
        "feature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "amount": {
          "type": "number"
        },
        "balanceAfter": {
          "type": "number"
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "note": {
          "type": "string",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "type", "feature", "amount", "balanceAfter", "actorId", "createdAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "AI Chatbot conversation thread owned by a single user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "lastMessagePreview": {
          "type": "string",
          "maxLength": 240
        },
        "messageCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "model", "messageCount", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message within an AI chat session.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant"]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "sessionId", "role", "content", "createdAt"]
    },
    "CreationItem": {
      "title": "CreationItem",
      "description": "Metadata log for generated or edited images, videos, and text outputs.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "image_edit",
            "bg_remove",
            "photo_enhance",
            "video_edit",
            "text_tool"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "aspectRatio": {
          "type": "string",
          "maxLength": 16
        },
        "summary": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "type", "prompt", "model", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles, role assignments, and server-managed credit balances."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Authorized admin access records and permission sets."
    },
    "/credit_transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/CreditTransaction" },
      "description": "Credit mutation audit trail per user."
    },
    "/chat_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "User-owned AI chat threads."
    },
    "/chat_sessions/{sessionId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages belonging to a specific chat session."
    },
    "/creations/{creationId}": {
      "schema": { "$ref": "#/entities/CreationItem" },
      "description": "History of AI studio outputs generated by the user."
    }
  }
}
