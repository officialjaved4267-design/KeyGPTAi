rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'officialjaved4267@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'email', 'username', 'role', 'credits', 'unlimitedCredits', 'status', 'lastCreditReset', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'username', 'displayName', 'role', 'credits', 'unlimitedCredits', 'status', 'lastCreditReset', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 40
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80))
        && data.role in ['user', 'moderator', 'admin', 'super_admin']
        && (data.credits is int || data.credits is float) && data.credits >= 0
        && data.unlimitedCredits is bool
        && data.status in ['active', 'suspended']
        && data.lastCreditReset is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'username', 'role', 'permissions', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'username', 'role', 'permissions', 'grantedBy', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 40
        && data.role in ['super_admin', 'admin', 'moderator']
        && data.permissions is list && data.permissions.size() <= 10
        && (data.permissions.size() == 0 || (data.permissions[0] is string && data.permissions[0].size() <= 64))
        && data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidCreditTransaction(data) {
      return data.keys().hasAll(['userId', 'type', 'feature', 'amount', 'balanceAfter', 'actorId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'type', 'feature', 'amount', 'balanceAfter', 'actorId', 'note', 'createdAt'])
        && isValidId(data.userId)
        && data.type in ['signup_bonus', 'daily_reset', 'ai_usage', 'admin_add', 'admin_deduct', 'admin_set', 'admin_unlimited']
        && data.feature is string && data.feature.size() >= 1 && data.feature.size() <= 80
        && (data.amount is int || data.amount is float)
        && (data.balanceAfter is int || data.balanceAfter is float) && data.balanceAfter >= 0
        && data.actorId is string && data.actorId.size() >= 1 && data.actorId.size() <= 128
        && (!('note' in data) || (data.note is string && data.note.size() <= 240))
        && data.createdAt is timestamp;
    }

    function isValidChatSession(data) {
      return data.keys().hasAll(['userId', 'title', 'model', 'messageCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'title', 'model', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.model is string && data.model.size() >= 1 && data.model.size() <= 64
        && (!('lastMessagePreview' in data) || (data.lastMessagePreview is string && data.lastMessagePreview.size() <= 240))
        && (data.messageCount is int || data.messageCount is float) && data.messageCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['userId', 'sessionId', 'role', 'content', 'createdAt'])
        && data.keys().hasOnly(['userId', 'sessionId', 'role', 'content', 'createdAt'])
        && isValidId(data.userId)
        && isValidId(data.sessionId)
        && data.role in ['user', 'assistant']
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 16000
        && data.createdAt is timestamp;
    }

    function isValidCreationItem(data) {
      return data.keys().hasAll(['userId', 'type', 'prompt', 'model', 'createdAt'])
        && data.keys().hasOnly(['userId', 'type', 'prompt', 'model', 'aspectRatio', 'summary', 'createdAt'])
        && isValidId(data.userId)
        && data.type in ['image_generate', 'image_edit', 'bg_remove', 'photo_enhance', 'video_generate', 'video_edit', 'text_tool']
        && data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 2000
        && data.model is string && data.model.size() >= 1 && data.model.size() <= 64
        && (!('aspectRatio' in data) || (data.aspectRatio is string && data.aspectRatio.size() <= 16))
        && (!('summary' in data) || (data.summary is string && data.summary.size() <= 1000))
        && data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    // 1. Users Collection (PII isolated, self-credit/role mutation strictly forbidden)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && existing().uid == request.auth.uid;

      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().role == 'user'
        && incoming().credits == 50
        && incoming().unlimitedCredits == false
        && incoming().status == 'active'
        && incoming().lastCreditReset == request.time
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isVerified()
            && isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();
    }

    // 2. Admins Collection (Admin-only read and write)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(adminId)
        && isValidAdminRecord(incoming())
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(adminId)
        && isValidAdminRecord(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(adminId) && isAdmin();
    }

    // 3. Credit Transactions (Users can only read their own; only admins can write)
    match /credit_transactions/{transactionId} {
      allow get: if isValidId(transactionId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isAdmin()
        && isValidId(transactionId)
        && isValidCreditTransaction(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(transactionId) && isAdmin();
    }

    // 4. Chat Sessions & Messages (Owner-scoped + Master Gate on subcollection)
    match /chat_sessions/{sessionId} {
      allow get: if isValidId(sessionId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isVerified()
        && isValidId(sessionId)
        && isValidChatSession(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(sessionId)
        && isValidChatSession(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'lastMessagePreview', 'messageCount', 'updatedAt']);
      allow delete: if isValidId(sessionId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());

      match /messages/{messageId} {
        allow get: if isValidId(sessionId) && isValidId(messageId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && existing().userId == request.auth.uid;
        allow create: if isVerified()
          && isValidId(sessionId)
          && isValidId(messageId)
          && isValidChatMessage(incoming())
          && incoming().userId == request.auth.uid
          && incoming().sessionId == sessionId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/chat_sessions/$(sessionId))
          && get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.userId == request.auth.uid;
        allow update: if false;
        allow delete: if isValidId(sessionId) && isValidId(messageId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      }
    }

    // 5. Creations History
    match /creations/{creationId} {
      allow get: if isValidId(creationId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isVerified()
        && isValidId(creationId)
        && isValidCreationItem(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(creationId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
